    "@echo/discord-contract": "workspace:*",
    "@echo/module-sdk": "workspace:*",
    "@echo/protocol": "workspace:*",
    "@snazzah/davey": "^0.1.9",
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "discord.js": "^14.27.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
